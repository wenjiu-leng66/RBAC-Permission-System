@startuml
!pragma layout smetana
left to right direction
skinparam dpi 170

skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 14
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam nodesep 35
skinparam ranksep 45
skinparam class {
  BackgroundColor #EAF1FB
  BorderColor #4A6FA5
  FontColor #1F2937
}
skinparam entity {
  BackgroundColor #EAF1FB
  BorderColor #4A6FA5
  FontColor #1F2937
}
skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
  FontColor #1F2937
}
skinparam component {
  BackgroundColor #EAF1FB
  BorderColor #4A6FA5
  FontColor #1F2937
}
skinparam rectangle {
  BackgroundColor #EAF1FB
  BorderColor #4A6FA5
  FontColor #1F2937
}
skinparam usecase {
  BackgroundColor #FFF7E6
  BorderColor #D6A84B
  FontColor #1F2937
}
skinparam database {
  BackgroundColor #EAF1FB
  BorderColor #4A6FA5
  FontColor #1F2937
}
skinparam note {
  BackgroundColor #FFF7E6
  BorderColor #D6A84B
}

skinparam defaultFontSize 16
package "边界类 web" {
  class AuthController <<boundary>> {
    +login()
    +switchApp()
  }
  class PortalController <<boundary>> {
    +menu()
    +placeholderAction()
  }
  class UserController <<boundary>> {
    +list()
    +update()
  }
  class RoleController <<boundary>> {
    +save()
    +inherits()
  }
  class GrantController <<boundary>> {
    +replaceUserRoles()
  }
  class CatalogAdminController <<boundary>> {
    +registerApi()
    +mapPermissionApi()
  }
}
package "控制类 application" {
  class AuthAppService <<control>> {
    +login(username, password, appCode)
    +switchApp(appCode)
  }
  class AuthorizationService <<control>> {
    +authorize(principal, operationId, target)
  }
  class UserAppService <<control>> {
    +listUsers(filter, scope)
  }
  class RoleAppService <<control>> {
    +saveRole(form)
    +setInheritance(roleId, parentIds)
  }
  class GrantAppService <<control>> {
    +replaceUserRoles(userId, roleIds, version)
    +replaceRoleGrants(roleId, grants, version)
  }
  class CatalogAppService <<control>> {
    +registerApi(api)
    +mapPermissionApi(permissionId, apiIds)
  }
  class PortalAppService <<control>> {
    +menu(userId, appCode)
  }
}
package "领域服务 domain" {
  class EffectivePermissionCalculator <<domain>> {
    +calculate(userId, appCode, version)
  }
  class ApiPermissionResolver <<domain>> {
    +resolve(operationId)
  }
  class MenuTreeAssembler <<domain>> {
    +assemble(userId, appCode)
  }
  class ConstraintChecker <<domain>> {
    +checkAssignment(userId, roleIds)
  }
  class ScopeResolver <<domain>> {
    +check(permission, target)
  }
}
class Session <<entity>> {
  +String appCode
  +Long authzVersionSeen
}
AuthController --> AuthAppService
PortalController --> PortalAppService
UserController --> UserAppService
RoleController --> RoleAppService
GrantController --> GrantAppService
CatalogAdminController --> CatalogAppService
AuthAppService --> Session
AuthAppService --> EffectivePermissionCalculator
PortalAppService --> MenuTreeAssembler
PortalAppService --> EffectivePermissionCalculator
AuthorizationService --> ApiPermissionResolver
AuthorizationService --> EffectivePermissionCalculator
AuthorizationService --> ScopeResolver
UserAppService --> ScopeResolver
GrantAppService --> ConstraintChecker
GrantAppService --> ScopeResolver
RoleAppService --> ConstraintChecker
@enduml
